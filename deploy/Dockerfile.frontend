# 医疗运营数据主题分析平台 —— 前端镜像（多阶段构建）
# build 阶段执行 npm run build 产出 dist，runtime 阶段用 Nginx 托管静态资源并暴露 80。
# /api 反向代理由 edge nginx 服务承担（见 deploy/nginx.conf 与 docker-compose.yml）。
#
# 构建上下文为项目根目录：
#   docker build -f deploy/Dockerfile.frontend -t moa-frontend .

# ---------------------------------------------------------------- 构建阶段
FROM node:20-alpine AS build

WORKDIR /app

ENV NODE_ENV=production

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm config set registry https://registry.npmmirror.com \
    && (npm ci || npm install --no-fund --no-audit)

COPY frontend/ ./
RUN npm run build

# ---------------------------------------------------------------- 运行阶段
FROM nginx:1.27-alpine AS runtime

ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
