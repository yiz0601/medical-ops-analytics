# 医疗运营数据主题分析平台 —— 部署环境变量模板
# 使用方法：复制本文件为 deploy/.env 后按实际环境修改
#   Windows (PowerShell)：Copy-Item deploy/.env.example deploy/.env
#   Linux/macOS        ：cp deploy/.env.example deploy/.env
# 安全要求：deploy/.env 已被 .gitignore 忽略，严禁提交到代码仓库或写入文档

# ---------- 应用 ----------
# 运行环境标识：dev / test / prod
APP_ENV=prod
TZ=Asia/Shanghai

# ---------- MySQL 容器初始化（仅首次启动生效） ----------
MYSQL_ROOT_PASSWORD=Moa@Root123
MYSQL_DATABASE=medical_ops
MYSQL_USER=moa
MYSQL_PASSWORD=Moa@123456

# ---------- 后端数据库连接（与上面保持一致） ----------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=medical_ops
DB_USER=moa
DB_PASSWORD=Moa@123456

# ---------- 认证鉴权 ----------
# 生产环境务必替换为 32 位以上随机串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-secret-in-production

# ---------- 大模型（智能分析） ----------
# openai / azure / local（本地化部署模型走 openai 兼容协议）
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
