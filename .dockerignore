# Docker 构建上下文排除清单
# 目的：避免把依赖目录、构建产物、运行期日志与密钥送入镜像构建上下文
# （frontend/node_modules 约 100MB+，不排除会显著拖慢 docker build）

# ---------- 依赖与虚拟环境 ----------
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# ---------- 构建产物 ----------
dist/
frontend/dist/
build/
*.egg-info/

# ---------- 运行期数据与日志 ----------
*.log
logs/
backend/etl/logs/
uploads/
.coverage
.pytest_cache/
htmlcov/

# ---------- 密钥与本地配置 ----------
.env
deploy/.env
*.pem
*.key
deploy/certs/

# ---------- 版本库与编辑器 ----------
.git/
.gitignore
.github/
.idea/
.vscode/
Thumbs.db
desktop.ini
